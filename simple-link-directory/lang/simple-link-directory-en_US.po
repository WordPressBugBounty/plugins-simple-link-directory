msgid "Choose which AI provider to enable for the directory features. Selecting \"Disable AI\" turns off all AI functionalities."
msgstr "Choose which AI provider to enable for the directory features. Selecting \"Disable AI\" turns off all AI functionalities."

msgid "You can use our given SHORTCODE GENERATOR to generate and insert shortcode easily, titled as \"SLD\" with WordPress content editor."
msgstr "You can use our given SHORTCODE GENERATOR to generate and insert shortcode easily, titled as \"SLD\" with WordPress content editor."

msgid "[qcopd-directory mode=\"all\" column=\"2\" style=\"simple\" orderby=\"date\" order=\"DESC\" enable_embedding=\"false\"]"
msgstr "[qcopd-directory mode=\"all\" column=\"2\" style=\"simple\" orderby=\"date\" order=\"DESC\" enable_embedding=\"false\"]"

msgid "[qcopd-directory mode=\"one\" list_id=\"75\"]"
msgstr "[qcopd-directory mode=\"one\" list_id=\"75\"]"

msgid "[Value for this option can be set as \"one\" or \"all\".]"
msgstr "[Value for this option can be set as \"one\" or \"all\".]"

msgid "Avaialble values: \"1\", \"2\", \"3\" or \"4\"."
msgstr "Available values: \"1\", \"2\", \"3\" or \"4\"."

msgid "Avaialble values: \"simple\", \"style-1\", \"style-2\", \"style-3\", \"style-4\", \"style-5\", \"style-16\"."
msgstr "Available values: \"simple\", \"style-1\", \"style-2\", \"style-3\", \"style-4\", \"style-5\", \"style-16\"."

msgid "Value for this option can be set as \"ASC\" for Ascending or \"DESC\" for Descending order."
msgstr "Value for this option can be set as \"ASC\" for Ascending or \"DESC\" for Descending order."

msgid "Value for this option are \"title\", \"upvotes\", \"timestamp\" that will be set as \"ASC\" & others will be \"DESC\" order."
msgstr "Value for this option are \"title\", \"upvotes\", \"timestamp\" that will be set as \"ASC\" &amp; others will be \"DESC\" order."

msgid "Only applicable if you want to display a single list [not all]. You can provide specific list id here as a value. You can also get ready shortcode for a single list under \"Manage List Items\" menu."
msgstr "Only applicable if you want to display a single list [not all]. You can provide specific list id here as a value. You can also get ready shortcode for a single list under \"Manage List Items\" menu."

msgid "Allow visitors to embed list in other sites. Supported values - \"true\", \"false\"."
msgstr "Allow visitors to embed list in other sites. Supported values - \"true\", \"false\"."

msgid "Example: enable_embedding=\"true\""
msgstr "Example: enable_embedding=\"true\""

msgid "Allow visitors to list item. Supported values - \"on\", \"off\"."
msgstr "Allow visitors to list item. Supported values - \"on\", \"off\"."

msgid "Example: upvote=\"on\""
msgstr "Example: upvote=\"on\""

msgid " Add the shortcode parameter enable_image=\"true\" to show images with style-16"
msgstr " Add the shortcode parameter enable_image=\"true\" to show images with style-16"

msgid "Example: enable_image=\"true\""
msgstr "Example: enable_image=\"true\""

msgid " Add the shortcode parameter search=\"true\" to show Live Search"
msgstr " Add the shortcode parameter search=\"true\" to show Live Search"

msgid "Example: search=\"true\""
msgstr "Example: search=\"true\""

msgid "You can use this value to use the dark_mode of SLD templates. Available values for this option \"on\", \"off\"."
msgstr "You can use this value to use the dark_mode of SLD templates. Available values for this option \"on\", \"off\"."

